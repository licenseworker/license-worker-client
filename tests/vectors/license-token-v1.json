  "key_hash": "95d1cebc39fc7dd5945f7a10ecac34ff926593962b63c1334a836235de58cafe",
  "key_hash_rule": "sha256 hex of the licence key with all whitespace removed and lowercased",
  "default_grace_seconds": 1209600,
  "rules": [
    "Verify the signature before trusting any payload field; kid only selects the embedded key.",
    "typ=revoked verifies to state 'revoked' whatever the instance: it is about the key.",
    "A changed payload may fail as malformed JSON before the signature is checked; where a case lists also_acceptable, any of those reasons is a correct rejection.",
    "exp=null is perpetual and ignores the clock. Otherwise now=max(now, high_water_mark); valid until exp, grace until exp+grace, then expired."
  ],
